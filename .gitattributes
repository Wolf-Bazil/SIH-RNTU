# The repository is edited on Windows but deployed on Linux. Anything the VPS
# executes or parses must check out with LF endings -- a shell script with CRLF
# fails immediately with `$'\r': command not found`.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
requirements.txt text eol=lf
